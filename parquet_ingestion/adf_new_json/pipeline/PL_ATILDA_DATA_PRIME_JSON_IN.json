{
    "name": "PL_ATILDA_DATA_PRIME_JSON_IN",
    "properties": {
        "description": "Data prime, part 1 (data in): extract one SQL Server table to JSON part files in <p_Landing_Container>/<SOURCE_PATH>/, in parallel key-range batches. ADF version of the PDF Python script. The source query is validated and built by 'Get source columns' in PL_ATILDA_DATA_PRIME_JSON before anything changes. Returns the rows extracted per batch. Called by PL_ATILDA_DATA_PRIME_JSON.",
        "activities": [
            {
                "name": "Extract batches",
                "type": "ForEach",
                "dependsOn": [],
                "userProperties": [],
                "typeProperties": {
                    "items": {
                        "value": "@pipeline().parameters.p_Batches",
                        "type": "Expression"
                    },
                    "isSequential": false,
                    "batchCount": 4,
                    "activities": [
                        {
                            "name": "Extract to json",
                            "type": "Copy",
                            "dependsOn": [],
                            "policy": {
                                "timeout": "1.00:00:00",
                                "retry": 0,
                                "retryIntervalInSeconds": 30,
                                "secureOutput": false,
                                "secureInput": false
                            },
                            "userProperties": [],
                            "description": "One key-range batch (p_Rows_Per_File rows) to one JSON file <prefix>_part_<RunId>_b<k>_1.json (gzip content, as the delta writes). No retry needed: a re-run overwrites the same name, but the prime is re-run as a whole.",
                            "typeProperties": {
                                "source": {
                                    "type": "SqlServerSource",
                                    "sqlReaderQuery": {
                                        "value": "@{pipeline().parameters.p_Source_Query}@{item().BATCH_FILTER}",
                                        "type": "Expression"
                                    },
                                    "queryTimeout": "12:00:00",
                                    "partitionOption": "None"
                                },
                                "sink": {
                                    "type": "JsonSink",
                                    "storeSettings": {
                                        "type": "AzureBlobStorageWriteSettings"
                                    },
                                    "formatSettings": {
                                        "type": "JsonWriteSettings"
                                    }
                                },
                                "enableStaging": false
                            },
                            "inputs": [
                                {
                                    "referenceName": "DS_SQLServer_Shared",
                                    "type": "DatasetReference",
                                    "parameters": {
                                        "ServerName": {
                                            "value": "@pipeline().globalParameters.SourceConfig[pipeline().parameters.p_Source_Name].ServerName",
                                            "type": "Expression"
                                        },
                                        "DatabaseName": {
                                            "value": "@pipeline().globalParameters.SourceConfig[pipeline().parameters.p_Source_Name].DatabaseName",
                                            "type": "Expression"
                                        },
                                        "UserNameSecretName": {
                                            "value": "@pipeline().globalParameters.SourceConfig[pipeline().parameters.p_Source_Name].UserNameSecretName",
                                            "type": "Expression"
                                        },
                                        "PasswordSecretName": {
                                            "value": "@pipeline().globalParameters.SourceConfig[pipeline().parameters.p_Source_Name].PasswordSecretName",
                                            "type": "Expression"
                                        }
                                    }
                                }
                            ],
                            "outputs": [
                                {
                                    "referenceName": "DS_Storage_Stage_JSON",
                                    "type": "DatasetReference",
                                    "parameters": {
                                        "Folder": {
                                            "value": "@pipeline().parameters.p_Source_Path",
                                            "type": "Expression"
                                        },
                                        "File": {
                                            "value": "@{pipeline().parameters.p_File_Prefix}_part_@{pipeline().parameters.p_Run_Id}_b@{item().BATCH_NO}_1.json",
                                            "type": "Expression"
                                        },
                                        "Container": {
                                            "value": "@pipeline().parameters.p_Landing_Container",
                                            "type": "Expression"
                                        }
                                    }
                                }
                            ]
                        },
                        {
                            "name": "Collect batch rows",
                            "type": "AppendVariable",
                            "dependsOn": [
                                {
                                    "activity": "Extract to json",
                                    "dependencyConditions": [
                                        "Succeeded"
                                    ]
                                }
                            ],
                            "userProperties": [],
                            "typeProperties": {
                                "variableName": "vBatch_Rows",
                                "value": {
                                    "value": "@json(concat('{\"b\":\"', string(item().BATCH_NO), '\",\"rows\":', string(activity('Extract to json').output.rowsCopied), '}'))",
                                    "type": "Expression"
                                }
                            }
                        }
                    ]
                }
            },
            {
                "name": "Return batch rows",
                "type": "SetVariable",
                "dependsOn": [
                    {
                        "activity": "Extract batches",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "userProperties": [],
                "policy": {
                    "secureOutput": false,
                    "secureInput": false
                },
                "description": "Returns [{b, rows}] per batch to PL_ATILDA_DATA_PRIME_JSON, which reconciles them against BRONZE.",
                "typeProperties": {
                    "variableName": "pipelineReturnValue",
                    "setSystemVariable": true,
                    "value": [
                        {
                            "key": "batch_rows",
                            "value": {
                                "type": "Expression",
                                "content": "@variables('vBatch_Rows')"
                            }
                        }
                    ]
                }
            }
        ],
        "parameters": {
            "p_Source_Name": {
                "type": "string"
            },
            "p_Source_Path": {
                "type": "string"
            },
            "p_File_Prefix": {
                "type": "string"
            },
            "p_Run_Id": {
                "type": "string"
            },
            "p_Source_Query": {
                "type": "string"
            },
            "p_Batches": {
                "type": "array"
            },
            "p_Landing_Container": {
                "type": "string",
                "defaultValue": "json-priming"
            }
        },
        "variables": {
            "vBatch_Rows": {
                "type": "Array",
                "defaultValue": []
            }
        },
        "folder": {
            "name": "ALTIDA/00 Templates/01 Extract/03 Data Prime JSON/Child"
        },
        "annotations": []
    }
}
