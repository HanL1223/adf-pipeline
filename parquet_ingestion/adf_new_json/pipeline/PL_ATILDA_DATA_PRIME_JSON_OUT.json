{
    "name": "PL_ATILDA_DATA_PRIME_JSON_OUT",
    "properties": {
        "description": "Data prime, part 2 (data out): plan this run's JSON files in ATILDA (one plan per file), then per plan copy the file to the ATILDA path and load it into BRONZE, one at a time (house file-pipeline loop). Called by PL_ATILDA_DATA_PRIME_JSON.",
        "activities": [
            {
                "name": "Get File Metadata",
                "type": "GetMetadata",
                "dependsOn": [],
                "policy": {
                    "timeout": "0.01:00:00",
                    "retry": 2,
                    "retryIntervalInSeconds": 30,
                    "secureOutput": false,
                    "secureInput": false
                },
                "userProperties": [],
                "description": "exists is listed so a missing folder (0 rows extracted) does not fail the activity.",
                "typeProperties": {
                    "dataset": {
                        "referenceName": "DS_STORAGE_V2_STAGE_BIN",
                        "type": "DatasetReference",
                        "parameters": {
                            "Folder": {
                                "value": "@pipeline().parameters.p_Source_Path",
                                "type": "Expression"
                            },
                            "Container": {
                                "value": "@pipeline().parameters.p_Landing_Container",
                                "type": "Expression"
                            }
                        }
                    },
                    "fieldList": [
                        "exists",
                        "childItems"
                    ],
                    "storeSettings": {
                        "type": "AzureBlobStorageReadSettings",
                        "recursive": false
                    },
                    "formatSettings": {
                        "type": "BinaryReadSettings"
                    }
                }
            },
            {
                "name": "Keep run files",
                "type": "Filter",
                "dependsOn": [
                    {
                        "activity": "Get File Metadata",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "userProperties": [],
                "typeProperties": {
                    "items": {
                        "value": "@coalesce(activity('Get File Metadata').output?.childItems, json('[]'))",
                        "type": "Expression"
                    },
                    "condition": {
                        "value": "@and(equals(item().type, 'File'), and(startswith(item().name, concat(pipeline().parameters.p_File_Prefix, '_part_', pipeline().parameters.p_Run_Id, '_')), endswith(toLower(item().name), '.json')))",
                        "type": "Expression"
                    }
                }
            },
            {
                "name": "Check file count",
                "type": "IfCondition",
                "dependsOn": [
                    {
                        "activity": "Keep run files",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "userProperties": [],
                "typeProperties": {
                    "expression": {
                        "value": "@greater(length(activity('Keep run files').output.Value), int(variables('vConst_Max_Files')))",
                        "type": "Expression"
                    },
                    "ifTrueActivities": [
                        {
                            "name": "Raise too many files",
                            "type": "Fail",
                            "dependsOn": [],
                            "userProperties": [],
                            "typeProperties": {
                                "message": {
                                    "value": "@concat(string(length(activity('Keep run files').output.Value)), ' files exceed the ', variables('vConst_Max_Files'), '-row Lookup limit. Raise p_Rows_Per_File and re-run.')",
                                    "type": "Expression"
                                },
                                "errorCode": "PRIME_TOO_MANY_FILES"
                            }
                        }
                    ]
                }
            },
            {
                "name": "Plan new files",
                "type": "IfCondition",
                "dependsOn": [
                    {
                        "activity": "Check file count",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "userProperties": [],
                "typeProperties": {
                    "expression": {
                        "value": "@greater(length(activity('Keep run files').output.Value), 0)",
                        "type": "Expression"
                    },
                    "ifTrueActivities": [
                        {
                            "name": "Generate Run Plan",
                            "type": "Lookup",
                            "dependsOn": [],
                            "policy": {
                                "timeout": "0.12:00:00",
                                "retry": 0,
                                "retryIntervalInSeconds": 30,
                                "secureOutput": false,
                                "secureInput": false
                            },
                            "userProperties": [],
                            "typeProperties": {
                                "source": {
                                    "type": "SnowflakeV2Source",
                                    "query": {
                                        "value": "CALL CONTROL.PR_CREATE_EXTRACT_RUN_PLAN_FILE('@{replace(pipeline().parameters.p_Initial_Source_Name, '''', '''''')}', '@{replace(pipeline().parameters.p_Source_Path, '''', '''''')}', $$@{string(activity('Keep run files').output.Value)}$$, '0', '0');",
                                        "type": "Expression"
                                    },
                                    "exportSettings": {
                                        "type": "SnowflakeExportCopyCommand"
                                    }
                                },
                                "dataset": {
                                    "referenceName": "DS_Snowflake_Wh",
                                    "type": "DatasetReference"
                                },
                                "firstRowOnly": true
                            }
                        }
                    ]
                }
            },
            {
                "name": "Get run plan",
                "type": "Lookup",
                "dependsOn": [
                    {
                        "activity": "Plan new files",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "policy": {
                    "timeout": "0.12:00:00",
                    "retry": 2,
                    "retryIntervalInSeconds": 30,
                    "secureOutput": false,
                    "secureInput": false
                },
                "userProperties": [],
                "typeProperties": {
                    "source": {
                        "type": "SnowflakeV2Source",
                        "query": {
                            "value": "SELECT EXTRACT_RUN_PLAN_ID, EXTRACT_META_ID, FILE_NAME, SOURCE_PATH, LVL1_FOLDER_NAME, OBJECT_NAME, SOURCE_EXTRACT_STATUS FROM CONTROL.EXTRACT_RUN_PLAN_VW WHERE EXTRACT_META_ID = @{pipeline().parameters.p_Initial_Meta_Id} AND CONTAINS(FILE_NAME, '_part_@{pipeline().parameters.p_Run_Id}_') ORDER BY FILE_NAME",
                            "type": "Expression"
                        },
                        "exportSettings": {
                            "type": "SnowflakeExportCopyCommand"
                        }
                    },
                    "dataset": {
                        "referenceName": "DS_Snowflake_Wh",
                        "type": "DatasetReference"
                    },
                    "firstRowOnly": false
                }
            },
            {
                "name": "Check plan count",
                "type": "IfCondition",
                "dependsOn": [
                    {
                        "activity": "Get run plan",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "userProperties": [],
                "typeProperties": {
                    "expression": {
                        "value": "@not(equals(length(activity('Get run plan').output.value), length(activity('Keep run files').output.Value)))",
                        "type": "Expression"
                    },
                    "ifTrueActivities": [
                        {
                            "name": "Raise plan count mismatch",
                            "type": "Fail",
                            "dependsOn": [],
                            "userProperties": [],
                            "typeProperties": {
                                "message": {
                                    "value": "@concat('ATILDA planned ', string(length(activity('Get run plan').output.value)), ' of ', string(length(activity('Keep run files').output.Value)), ' files for run ', pipeline().parameters.p_Run_Id, '. Check CONTROL.EXTRACT_RUN_PLAN_STATUS_VW.')",
                                    "type": "Expression"
                                },
                                "errorCode": "PRIME_PLAN_COUNT_MISMATCH"
                            }
                        }
                    ]
                }
            },
            {
                "name": "Load files",
                "type": "ForEach",
                "dependsOn": [
                    {
                        "activity": "Check plan count",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "userProperties": [],
                "typeProperties": {
                    "items": {
                        "value": "@activity('Get run plan').output.value",
                        "type": "Expression"
                    },
                    "isSequential": true,
                    "activities": [
                        {
                            "name": "If BATCH ID exists",
                            "type": "IfCondition",
                            "dependsOn": [],
                            "userProperties": [],
                            "typeProperties": {
                                "expression": {
                                    "value": "@empty(pipeline().parameters.p_Batch_ID)",
                                    "type": "Expression"
                                },
                                "ifFalseActivities": [
                                    {
                                        "name": "SET BATCH ID",
                                        "type": "Lookup",
                                        "dependsOn": [],
                                        "policy": {
                                            "timeout": "0.12:00:00",
                                            "retry": 2,
                                            "retryIntervalInSeconds": 30,
                                            "secureOutput": false,
                                            "secureInput": false
                                        },
                                        "userProperties": [],
                                        "typeProperties": {
                                            "source": {
                                                "type": "SnowflakeV2Source",
                                                "query": {
                                                    "value": "CALL CONTROL.PR_LOG_EXTRACT_RUN_PLAN(@{item().EXTRACT_RUN_PLAN_ID}, '@{variables('vConst_Batch_Id')}', '@{replace(pipeline().parameters.p_Batch_ID, '''', '''''')}', 'Successful');",
                                                    "type": "Expression"
                                                },
                                                "exportSettings": {
                                                    "type": "SnowflakeExportCopyCommand"
                                                }
                                            },
                                            "dataset": {
                                                "referenceName": "DS_Snowflake_Wh",
                                                "type": "DatasetReference"
                                            },
                                            "firstRowOnly": true
                                        }
                                    }
                                ]
                            }
                        },
                        {
                            "name": "Check if blobcopy is COMPLETE",
                            "type": "IfCondition",
                            "dependsOn": [
                                {
                                    "activity": "If BATCH ID exists",
                                    "dependencyConditions": [
                                        "Succeeded"
                                    ]
                                }
                            ],
                            "userProperties": [],
                            "typeProperties": {
                                "expression": {
                                    "value": "@equals(coalesce(item().SOURCE_EXTRACT_STATUS, ''), variables('vConst_Complete'))",
                                    "type": "Expression"
                                },
                                "ifFalseActivities": [
                                    {
                                        "name": "Copy to BLOB",
                                        "type": "Copy",
                                        "dependsOn": [],
                                        "policy": {
                                            "timeout": "0.12:00:00",
                                            "retry": 0,
                                            "retryIntervalInSeconds": 30,
                                            "secureOutput": false,
                                            "secureInput": false
                                        },
                                        "userProperties": [],
                                        "description": "Copies this plan's landing file (landing container, SOURCE_PATH/OBJECT_NAME) to the ATILDA path (staging container, LVL1_FOLDER_NAME/FILE_NAME), which PR_CREATE_EXTRACT_ARTIFACTS loads.",
                                        "typeProperties": {
                                            "source": {
                                                "type": "JsonSource",
                                                "storeSettings": {
                                                    "type": "AzureBlobStorageReadSettings",
                                                    "recursive": false
                                                },
                                                "formatSettings": {
                                                    "type": "JsonReadSettings"
                                                }
                                            },
                                            "sink": {
                                                "type": "JsonSink",
                                                "storeSettings": {
                                                    "type": "AzureBlobStorageWriteSettings"
                                                },
                                                "formatSettings": {
                                                    "type": "JsonWriteSettings"
                                                }
                                            },
                                            "enableStaging": false
                                        },
                                        "inputs": [
                                            {
                                                "referenceName": "DS_Storage_Stage_JSON",
                                                "type": "DatasetReference",
                                                "parameters": {
                                                    "Folder": {
                                                        "value": "@item().SOURCE_PATH",
                                                        "type": "Expression"
                                                    },
                                                    "File": {
                                                        "value": "@item().OBJECT_NAME",
                                                        "type": "Expression"
                                                    },
                                                    "Container": {
                                                        "value": "@pipeline().parameters.p_Landing_Container",
                                                        "type": "Expression"
                                                    }
                                                }
                                            }
                                        ],
                                        "outputs": [
                                            {
                                                "referenceName": "DS_Storage_Stage_JSON",
                                                "type": "DatasetReference",
                                                "parameters": {
                                                    "Folder": {
                                                        "value": "@item().LVL1_FOLDER_NAME",
                                                        "type": "Expression"
                                                    },
                                                    "File": {
                                                        "value": "@item().FILE_NAME",
                                                        "type": "Expression"
                                                    },
                                                    "Container": {
                                                        "value": "@pipeline().globalParameters.StagingContainer",
                                                        "type": "Expression"
                                                    }
                                                }
                                            }
                                        ]
                                    },
                                    {
                                        "name": "Update source rows read",
                                        "type": "Lookup",
                                        "dependsOn": [
                                            {
                                                "activity": "Copy to BLOB",
                                                "dependencyConditions": [
                                                    "Succeeded"
                                                ]
                                            }
                                        ],
                                        "policy": {
                                            "timeout": "0.12:00:00",
                                            "retry": 2,
                                            "retryIntervalInSeconds": 30,
                                            "secureOutput": false,
                                            "secureInput": false
                                        },
                                        "userProperties": [],
                                        "typeProperties": {
                                            "source": {
                                                "type": "SnowflakeV2Source",
                                                "query": {
                                                    "value": "CALL CONTROL.PR_LOG_EXTRACT_RUN_PLAN(@{item().EXTRACT_RUN_PLAN_ID}, '@{variables('vConst_Rows_Read')}', '@{string(coalesce(activity('Copy to BLOB').output?.rowsRead, 0))}', 'Successful');",
                                                    "type": "Expression"
                                                },
                                                "exportSettings": {
                                                    "type": "SnowflakeExportCopyCommand"
                                                }
                                            },
                                            "dataset": {
                                                "referenceName": "DS_Snowflake_Wh",
                                                "type": "DatasetReference"
                                            },
                                            "firstRowOnly": true
                                        }
                                    },
                                    {
                                        "name": "Complete BLOB copy",
                                        "type": "Lookup",
                                        "dependsOn": [
                                            {
                                                "activity": "Update source rows read",
                                                "dependencyConditions": [
                                                    "Succeeded"
                                                ]
                                            }
                                        ],
                                        "policy": {
                                            "timeout": "0.12:00:00",
                                            "retry": 2,
                                            "retryIntervalInSeconds": 30,
                                            "secureOutput": false,
                                            "secureInput": false
                                        },
                                        "userProperties": [],
                                        "typeProperties": {
                                            "source": {
                                                "type": "SnowflakeV2Source",
                                                "query": {
                                                    "value": "CALL CONTROL.PR_LOG_EXTRACT_RUN_PLAN(@{item().EXTRACT_RUN_PLAN_ID}, '@{variables('vConst_BlobCopy_Status')}', '@{variables('vConst_Complete')}', 'Successful');",
                                                    "type": "Expression"
                                                },
                                                "exportSettings": {
                                                    "type": "SnowflakeExportCopyCommand"
                                                }
                                            },
                                            "dataset": {
                                                "referenceName": "DS_Snowflake_Wh",
                                                "type": "DatasetReference"
                                            },
                                            "firstRowOnly": true
                                        }
                                    },
                                    {
                                        "name": "Fail BLOB copy",
                                        "type": "Lookup",
                                        "dependsOn": [
                                            {
                                                "activity": "Copy to BLOB",
                                                "dependencyConditions": [
                                                    "Failed"
                                                ]
                                            }
                                        ],
                                        "policy": {
                                            "timeout": "0.12:00:00",
                                            "retry": 2,
                                            "retryIntervalInSeconds": 30,
                                            "secureOutput": false,
                                            "secureInput": false
                                        },
                                        "userProperties": [],
                                        "typeProperties": {
                                            "source": {
                                                "type": "SnowflakeV2Source",
                                                "query": {
                                                    "value": "CALL CONTROL.PR_LOG_EXTRACT_RUN_PLAN(@{item().EXTRACT_RUN_PLAN_ID}, '@{variables('vConst_BlobCopy_Status')}', '@{variables('vConst_Fail')}', $$@{replace(activity('Copy to BLOB').error.message, '$$', '')}$$);",
                                                    "type": "Expression"
                                                },
                                                "exportSettings": {
                                                    "type": "SnowflakeExportCopyCommand"
                                                }
                                            },
                                            "dataset": {
                                                "referenceName": "DS_Snowflake_Wh",
                                                "type": "DatasetReference"
                                            },
                                            "firstRowOnly": true
                                        }
                                    },
                                    {
                                        "name": "Raise BLOB copy error",
                                        "type": "Fail",
                                        "dependsOn": [
                                            {
                                                "activity": "Fail BLOB copy",
                                                "dependencyConditions": [
                                                    "Completed"
                                                ]
                                            }
                                        ],
                                        "userProperties": [],
                                        "typeProperties": {
                                            "message": {
                                                "value": "@concat('Stage copy failed for plan ', string(item().EXTRACT_RUN_PLAN_ID), ': ', activity('Copy to BLOB').error.message)",
                                                "type": "Expression"
                                            },
                                            "errorCode": "PRIME_STAGE_COPY_FAILED"
                                        }
                                    }
                                ]
                            }
                        },
                        {
                            "name": "Provision SI artifacts and load data",
                            "type": "Lookup",
                            "dependsOn": [
                                {
                                    "activity": "Check if blobcopy is COMPLETE",
                                    "dependencyConditions": [
                                        "Succeeded"
                                    ]
                                }
                            ],
                            "policy": {
                                "timeout": "0.12:00:00",
                                "retry": 0,
                                "retryIntervalInSeconds": 30,
                                "secureOutput": false,
                                "secureInput": false
                            },
                            "userProperties": [],
                            "typeProperties": {
                                "source": {
                                    "type": "SnowflakeV2Source",
                                    "query": {
                                        "value": "CALL CONTROL.PR_CREATE_EXTRACT_ARTIFACTS(@{item().EXTRACT_META_ID}, @{item().EXTRACT_RUN_PLAN_ID});",
                                        "type": "Expression"
                                    },
                                    "exportSettings": {
                                        "type": "SnowflakeExportCopyCommand"
                                    }
                                },
                                "dataset": {
                                    "referenceName": "DS_Snowflake_Wh",
                                    "type": "DatasetReference"
                                },
                                "firstRowOnly": true
                            }
                        },
                        {
                            "name": "Complete ETL run",
                            "type": "Lookup",
                            "dependsOn": [
                                {
                                    "activity": "Provision SI artifacts and load data",
                                    "dependencyConditions": [
                                        "Succeeded"
                                    ]
                                }
                            ],
                            "policy": {
                                "timeout": "0.12:00:00",
                                "retry": 2,
                                "retryIntervalInSeconds": 30,
                                "secureOutput": false,
                                "secureInput": false
                            },
                            "userProperties": [],
                            "typeProperties": {
                                "source": {
                                    "type": "SnowflakeV2Source",
                                    "query": {
                                        "value": "CALL CONTROL.PR_LOG_EXTRACT_RUN_PLAN(@{item().EXTRACT_RUN_PLAN_ID}, '@{variables('vConst_Run_Status')}', '@{variables('vConst_Complete')}', 'Successful');",
                                        "type": "Expression"
                                    },
                                    "exportSettings": {
                                        "type": "SnowflakeExportCopyCommand"
                                    }
                                },
                                "dataset": {
                                    "referenceName": "DS_Snowflake_Wh",
                                    "type": "DatasetReference"
                                },
                                "firstRowOnly": true
                            }
                        }
                    ]
                }
            }
        ],
        "parameters": {
            "p_Initial_Meta_Id": {
                "type": "string"
            },
            "p_Initial_Source_Name": {
                "type": "string"
            },
            "p_Source_Path": {
                "type": "string"
            },
            "p_File_Prefix": {
                "type": "string"
            },
            "p_Run_Id": {
                "type": "string"
            },
            "p_Batch_ID": {
                "type": "string",
                "defaultValue": ""
            },
            "p_Landing_Container": {
                "type": "string",
                "defaultValue": "json-priming"
            }
        },
        "variables": {
            "vConst_Max_Files": {
                "type": "String",
                "defaultValue": "5000"
            },
            "vConst_Complete": {
                "type": "String",
                "defaultValue": "COMPLETED"
            },
            "vConst_Fail": {
                "type": "String",
                "defaultValue": "FAILED"
            },
            "vConst_BlobCopy_Status": {
                "type": "String",
                "defaultValue": "source_extract_status"
            },
            "vConst_Rows_Read": {
                "type": "String",
                "defaultValue": "source_rows_read"
            },
            "vConst_Run_Status": {
                "type": "String",
                "defaultValue": "extract_run_plan_status"
            },
            "vConst_Batch_Id": {
                "type": "String",
                "defaultValue": "batch_id"
            }
        },
        "folder": {
            "name": "ALTIDA/00 Templates/01 Extract/03 Data Prime JSON/Child"
        },
        "annotations": []
    }
}
