{
    "name": "PL_ATILDA_DATA_PRIME_JSON_LOAD_FILE",
    "properties": {
        "description": "Data prime, part 2 per file: stage one ATILDA run plan's JSON file and load it into BRONZE (house TPL_E_FILE_PARQUET per-plan body, sample defects fixed). Called by PL_ATILDA_DATA_PRIME_JSON_OUT.",
        "activities": [
            {
                "name": "If BATCH ID exists",
                "type": "IfCondition",
                "dependsOn": [],
                "userProperties": [],
                "typeProperties": {
                    "expression": {
                        "value": "@empty(pipeline().parameters.p_Batch_ID)",
                        "type": "Expression"
                    },
                    "ifFalseActivities": [
                        {
                            "name": "SET BATCH ID",
                            "type": "Lookup",
                            "dependsOn": [],
                            "policy": {
                                "timeout": "0.12:00:00",
                                "retry": 2,
                                "retryIntervalInSeconds": 30,
                                "secureOutput": false,
                                "secureInput": false
                            },
                            "userProperties": [],
                            "typeProperties": {
                                "source": {
                                    "type": "SnowflakeV2Source",
                                    "query": {
                                        "value": "CALL CONTROL.PR_LOG_EXTRACT_RUN_PLAN(@{pipeline().parameters.p_Extract_Run_Plan_Id}, '@{variables('vConst_Batch_Id')}', '@{replace(pipeline().parameters.p_Batch_ID, '''', '''''')}', 'Successful');",
                                        "type": "Expression"
                                    },
                                    "exportSettings": {
                                        "type": "SnowflakeExportCopyCommand"
                                    }
                                },
                                "dataset": {
                                    "referenceName": "DS_Snowflake_Wh",
                                    "type": "DatasetReference"
                                },
                                "firstRowOnly": true
                            }
                        }
                    ]
                }
            },
            {
                "name": "Check if blobcopy is COMPLETE",
                "type": "IfCondition",
                "dependsOn": [
                    {
                        "activity": "If BATCH ID exists",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "userProperties": [],
                "typeProperties": {
                    "expression": {
                        "value": "@equals(pipeline().parameters.p_Source_Extract_Status, variables('vConst_Complete'))",
                        "type": "Expression"
                    },
                    "ifFalseActivities": [
                        {
                            "name": "Copy to BLOB",
                            "type": "Copy",
                            "dependsOn": [],
                            "policy": {
                                "timeout": "0.12:00:00",
                                "retry": 0,
                                "retryIntervalInSeconds": 30,
                                "secureOutput": false,
                                "secureInput": false
                            },
                            "userProperties": [],
                            "description": "Copies this plan's landing file (SOURCE_PATH/OBJECT_NAME) to the ATILDA path LVL1_FOLDER_NAME/FILE_NAME, which PR_CREATE_EXTRACT_ARTIFACTS loads.",
                            "typeProperties": {
                                "source": {
                                    "type": "JsonSource",
                                    "storeSettings": {
                                        "type": "AzureBlobStorageReadSettings",
                                        "recursive": false
                                    },
                                    "formatSettings": {
                                        "type": "JsonReadSettings"
                                    }
                                },
                                "sink": {
                                    "type": "JsonSink",
                                    "storeSettings": {
                                        "type": "AzureBlobStorageWriteSettings"
                                    },
                                    "formatSettings": {
                                        "type": "JsonWriteSettings"
                                    }
                                },
                                "enableStaging": false
                            },
                            "inputs": [
                                {
                                    "referenceName": "DS_Storage_Stage_JSON",
                                    "type": "DatasetReference",
                                    "parameters": {
                                        "Folder": {
                                            "value": "@pipeline().parameters.p_Source_Path",
                                            "type": "Expression"
                                        },
                                        "File": {
                                            "value": "@pipeline().parameters.p_Object_Name",
                                            "type": "Expression"
                                        },
                                        "Container": {
                                            "value": "@pipeline().globalParameters.StagingContainer",
                                            "type": "Expression"
                                        }
                                    }
                                }
                            ],
                            "outputs": [
                                {
                                    "referenceName": "DS_Storage_Stage_JSON",
                                    "type": "DatasetReference",
                                    "parameters": {
                                        "Folder": {
                                            "value": "@pipeline().parameters.p_Lvl1_Folder_Name",
                                            "type": "Expression"
                                        },
                                        "File": {
                                            "value": "@pipeline().parameters.p_File_Name",
                                            "type": "Expression"
                                        },
                                        "Container": {
                                            "value": "@pipeline().globalParameters.StagingContainer",
                                            "type": "Expression"
                                        }
                                    }
                                }
                            ]
                        },
                        {
                            "name": "Update source rows read",
                            "type": "Lookup",
                            "dependsOn": [
                                {
                                    "activity": "Copy to BLOB",
                                    "dependencyConditions": [
                                        "Succeeded"
                                    ]
                                }
                            ],
                            "policy": {
                                "timeout": "0.12:00:00",
                                "retry": 2,
                                "retryIntervalInSeconds": 30,
                                "secureOutput": false,
                                "secureInput": false
                            },
                            "userProperties": [],
                            "typeProperties": {
                                "source": {
                                    "type": "SnowflakeV2Source",
                                    "query": {
                                        "value": "CALL CONTROL.PR_LOG_EXTRACT_RUN_PLAN(@{pipeline().parameters.p_Extract_Run_Plan_Id}, '@{variables('vConst_Rows_Read')}', '@{string(coalesce(activity('Copy to BLOB').output?.rowsRead, 0))}', 'Successful');",
                                        "type": "Expression"
                                    },
                                    "exportSettings": {
                                        "type": "SnowflakeExportCopyCommand"
                                    }
                                },
                                "dataset": {
                                    "referenceName": "DS_Snowflake_Wh",
                                    "type": "DatasetReference"
                                },
                                "firstRowOnly": true
                            }
                        },
                        {
                            "name": "Complete BLOB copy",
                            "type": "Lookup",
                            "dependsOn": [
                                {
                                    "activity": "Update source rows read",
                                    "dependencyConditions": [
                                        "Succeeded"
                                    ]
                                }
                            ],
                            "policy": {
                                "timeout": "0.12:00:00",
                                "retry": 2,
                                "retryIntervalInSeconds": 30,
                                "secureOutput": false,
                                "secureInput": false
                            },
                            "userProperties": [],
                            "typeProperties": {
                                "source": {
                                    "type": "SnowflakeV2Source",
                                    "query": {
                                        "value": "CALL CONTROL.PR_LOG_EXTRACT_RUN_PLAN(@{pipeline().parameters.p_Extract_Run_Plan_Id}, '@{variables('vConst_BlobCopy_Status')}', '@{variables('vConst_Complete')}', 'Successful');",
                                        "type": "Expression"
                                    },
                                    "exportSettings": {
                                        "type": "SnowflakeExportCopyCommand"
                                    }
                                },
                                "dataset": {
                                    "referenceName": "DS_Snowflake_Wh",
                                    "type": "DatasetReference"
                                },
                                "firstRowOnly": true
                            }
                        },
                        {
                            "name": "Fail BLOB copy",
                            "type": "Lookup",
                            "dependsOn": [
                                {
                                    "activity": "Copy to BLOB",
                                    "dependencyConditions": [
                                        "Failed"
                                    ]
                                }
                            ],
                            "policy": {
                                "timeout": "0.12:00:00",
                                "retry": 2,
                                "retryIntervalInSeconds": 30,
                                "secureOutput": false,
                                "secureInput": false
                            },
                            "userProperties": [],
                            "typeProperties": {
                                "source": {
                                    "type": "SnowflakeV2Source",
                                    "query": {
                                        "value": "CALL CONTROL.PR_LOG_EXTRACT_RUN_PLAN(@{pipeline().parameters.p_Extract_Run_Plan_Id}, '@{variables('vConst_BlobCopy_Status')}', '@{variables('vConst_Fail')}', $$@{replace(activity('Copy to BLOB').error.message, '$$', '')}$$);",
                                        "type": "Expression"
                                    },
                                    "exportSettings": {
                                        "type": "SnowflakeExportCopyCommand"
                                    }
                                },
                                "dataset": {
                                    "referenceName": "DS_Snowflake_Wh",
                                    "type": "DatasetReference"
                                },
                                "firstRowOnly": true
                            }
                        },
                        {
                            "name": "Raise BLOB copy error",
                            "type": "Fail",
                            "dependsOn": [
                                {
                                    "activity": "Fail BLOB copy",
                                    "dependencyConditions": [
                                        "Completed"
                                    ]
                                }
                            ],
                            "userProperties": [],
                            "typeProperties": {
                                "message": {
                                    "value": "@concat('Stage copy failed for plan ', pipeline().parameters.p_Extract_Run_Plan_Id, ': ', activity('Copy to BLOB').error.message)",
                                    "type": "Expression"
                                },
                                "errorCode": "PRIME_STAGE_COPY_FAILED"
                            }
                        }
                    ]
                }
            },
            {
                "name": "Provision SI artifacts and load data",
                "type": "Lookup",
                "dependsOn": [
                    {
                        "activity": "Check if blobcopy is COMPLETE",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "policy": {
                    "timeout": "0.12:00:00",
                    "retry": 0,
                    "retryIntervalInSeconds": 30,
                    "secureOutput": false,
                    "secureInput": false
                },
                "userProperties": [],
                "typeProperties": {
                    "source": {
                        "type": "SnowflakeV2Source",
                        "query": {
                            "value": "CALL CONTROL.PR_CREATE_EXTRACT_ARTIFACTS(@{pipeline().parameters.p_Extract_Meta_Id}, @{pipeline().parameters.p_Extract_Run_Plan_Id});",
                            "type": "Expression"
                        },
                        "exportSettings": {
                            "type": "SnowflakeExportCopyCommand"
                        }
                    },
                    "dataset": {
                        "referenceName": "DS_Snowflake_Wh",
                        "type": "DatasetReference"
                    },
                    "firstRowOnly": true
                }
            },
            {
                "name": "Complete ETL run",
                "type": "Lookup",
                "dependsOn": [
                    {
                        "activity": "Provision SI artifacts and load data",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "policy": {
                    "timeout": "0.12:00:00",
                    "retry": 2,
                    "retryIntervalInSeconds": 30,
                    "secureOutput": false,
                    "secureInput": false
                },
                "userProperties": [],
                "typeProperties": {
                    "source": {
                        "type": "SnowflakeV2Source",
                        "query": {
                            "value": "CALL CONTROL.PR_LOG_EXTRACT_RUN_PLAN(@{pipeline().parameters.p_Extract_Run_Plan_Id}, '@{variables('vConst_Run_Status')}', '@{variables('vConst_Complete')}', 'Successful');",
                            "type": "Expression"
                        },
                        "exportSettings": {
                            "type": "SnowflakeExportCopyCommand"
                        }
                    },
                    "dataset": {
                        "referenceName": "DS_Snowflake_Wh",
                        "type": "DatasetReference"
                    },
                    "firstRowOnly": true
                }
            }
        ],
        "parameters": {
            "p_Extract_Run_Plan_Id": {
                "type": "string"
            },
            "p_Extract_Meta_Id": {
                "type": "string"
            },
            "p_File_Name": {
                "type": "string"
            },
            "p_Source_Path": {
                "type": "string"
            },
            "p_Lvl1_Folder_Name": {
                "type": "string"
            },
            "p_Source_Extract_Status": {
                "type": "string",
                "defaultValue": ""
            },
            "p_Batch_ID": {
                "type": "string",
                "defaultValue": ""
            },
            "p_Object_Name": {
                "type": "string"
            }
        },
        "variables": {
            "vConst_Complete": {
                "type": "String",
                "defaultValue": "COMPLETED"
            },
            "vConst_Fail": {
                "type": "String",
                "defaultValue": "FAILED"
            },
            "vConst_BlobCopy_Status": {
                "type": "String",
                "defaultValue": "source_extract_status"
            },
            "vConst_Rows_Read": {
                "type": "String",
                "defaultValue": "source_rows_read"
            },
            "vConst_Run_Status": {
                "type": "String",
                "defaultValue": "extract_run_plan_status"
            },
            "vConst_Batch_Id": {
                "type": "String",
                "defaultValue": "batch_id"
            }
        },
        "folder": {
            "name": "ALTIDA/00 Templates/01 Extract/03 Data Prime JSON/Child"
        },
        "annotations": []
    }
}
