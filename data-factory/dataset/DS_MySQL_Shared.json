					"type": "Expression"
				}
			}
		},
		"parameters": {
			"ServerName": {
				"type": "string"
			},
			"Port": {
				"type": "string"
			},
			"DatabaseName": {
				"type": "string"
			},
			"UserNameSecretName": {
				"type": "string"
			},
			"PasswordSecretName": {
				"type": "string"
			}
		},
		"folder": {
			"name": "05 MySQL"
		},
