{
	"name": "DI_FILE_INITIAL_Shared_Parquet",
	"properties": {
		"description": "CSV stage, can only run files sequentially. Using SNOWFLAKE V2 connector.",
		"activities": [
			{
				"name": "Loop through source objects",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "Get run plan",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [
					{
						"name": "Items",
						"value": "@activity('Get run plan').output.value"
					}
				],
				"typeProperties": {
					"items": {
						"value": "@activity('Get run plan').output.value",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
						{
							"name": "Check if blobcopy is COMPLETE",
							"type": "IfCondition",
							"dependsOn": [],
							"userProperties": [
								{
									"name": "OBJECT_NAME",
									"value": "@concat(item().OBJECT_NAME)"
								},
								{
									"name": "IFCONDITION_EXPRESSION",
									"value": "@equals(item().BLOB_COPY_STATUS,variables('vConst_Complete'))"
								}
							],
							"typeProperties": {
								"expression": {
									"value": "@equals(item().SOURCE_EXTRACT_STATUS,variables('vConst_Complete'))",
									"type": "Expression"
								},
								"ifFalseActivities": [
									{
										"name": "Copy to BLOB",
										"type": "Copy",
										"dependsOn": [],
										"policy": {
											"timeout": "7.00:00:00",
											"retry": 0,
											"retryIntervalInSeconds": 30,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [
											{
												"name": "OBJECT_NAME",
												"value": "@item().OBJECT_NAME"
											}
										],
										"typeProperties": {
											"source": {
												"type": "ParquetSource",
												"storeSettings": {
													"type": "AzureBlobStorageReadSettings",
													"recursive": true,
													"enablePartitionDiscovery": false
												},
												"formatSettings": {
													"type": "ParquetReadSettings"
												}
											},
											"sink": {
												"type": "ParquetSink",
												"storeSettings": {
													"type": "AzureBlobStorageWriteSettings"
												},
												"formatSettings": {
													"type": "ParquetWriteSettings"
												}
											},
											"enableStaging": false,
											"translator": {
												"type": "TabularTranslator",
												"typeConversion": true,
												"typeConversionSettings": {
													"allowDataTruncation": true,
													"treatBooleanAsNumber": false
												}
											}
										},
										"inputs": [
											{
												"referenceName": "DS_Storage_Parquetfiles",
												"type": "DatasetReference",
												"parameters": {
													"Folder": {
														"value": "@{item().SOURCE_PATH}",
														"type": "Expression"
													},
													"File": {
														"value": "@{item().OBJECT_NAME}",
														"type": "Expression"
													},
													"Container": {
														"value": "@pipeline().globalParameters.StagingContainer",
														"type": "Expression"
													}
												}
											}
										],
										"outputs": [
											{
												"referenceName": "DS_Storage_Landing_Parquet",
												"type": "DatasetReference",
												"parameters": {
													"Folder": "@{item().LVL1_FOLDER_NAME}",
													"File": "@{item().FILE_NAME}",
													"Container": {
														"value": "@pipeline().globalParameters.StagingContainer",
														"type": "Expression"
													}
												}
											}
										]
									},
									{
										"name": "Complete BLOB copy",
										"type": "Lookup",
										"dependsOn": [
											{
												"activity": "Update source rows read",
												"dependencyConditions": [
													"Succeeded"
												]
											}
										],
										"policy": {
											"timeout": "7.00:00:00",
											"retry": 0,
											"retryIntervalInSeconds": 30,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [
											{
												"name": "OBJECT_NAME",
												"value": "@item().OBJECT_NAME  "
											},
											{
												"name": "CALL_COMMAND",
												"value": "@concat('CALL CONTROL.PR_LOG_RUN_PLAN (',item().EXTRACT_RUN_PLAN_ID,',''', variables('vConst_BlobCopy_Status'),''',''',variables('vConst_Complete'),''')' )"
											}
										],
										"typeProperties": {
											"source": {
												"type": "SnowflakeV2Source",
												"query": {
													"value": "@concat('CALL CONTROL.PR_LOG_EXTRACT_RUN_PLAN (',item().EXTRACT_RUN_PLAN_ID,',''', variables('vConst_BlobCopy_Status'),''',''',variables('vConst_Complete'),''',''Successful'');')\n",
													"type": "Expression"
												},
												"exportSettings": {
													"type": "SnowflakeExportCopyCommand"
												}
											},
											"dataset": {
												"referenceName": "DS_Snowflake_Wh",
												"type": "DatasetReference"
											},
											"firstRowOnly": false
										}
									},
									{
										"name": "Fail BLOB copy",
										"type": "Lookup",
										"dependsOn": [
											{
												"activity": "Set vCopy_Error",
												"dependencyConditions": [
													"Succeeded"
												]
											}
										],
										"policy": {
											"timeout": "7.00:00:00",
											"retry": 0,
											"retryIntervalInSeconds": 30,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"source": {
												"type": "SnowflakeV2Source",
												"query": {
													"value": "@concat('CALL CONTROL.PR_LOG_EXTRACT_RUN_PLAN (',item().EXTRACT_RUN_PLAN_ID,',''', variables('vConst_BlobCopy_Status'),''',''',variables('vConst_Fail'),''',$$',variables('vCopy_Error'),'$$);')\n",
													"type": "Expression"
												},
												"exportSettings": {
													"type": "SnowflakeExportCopyCommand"
												}
											},
											"dataset": {
												"referenceName": "DS_Snowflake_Wh",
												"type": "DatasetReference"
											}
										}
									},
									{
										"name": "Set vRows_Read",
										"type": "SetVariable",
										"dependsOn": [
											{
												"activity": "Copy to BLOB",
												"dependencyConditions": [
													"Succeeded"
												]
											}
										],
										"policy": {
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"variableName": "vRows_Read",
											"value": {
												"value": "@string(activity('Copy to BLOB').output.dataRead)\n",
												"type": "Expression"
											}
										}
									},
									{
										"name": "Update source rows read",
										"type": "Lookup",
										"dependsOn": [
											{
												"activity": "Set vRows_Read",
												"dependencyConditions": [
													"Succeeded"
												]
											}
										],
										"policy": {
											"timeout": "7.00:00:00",
											"retry": 0,
											"retryIntervalInSeconds": 30,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [
											{
												"name": "OBJECT_NAME",
												"value": "@item().OBJECT_NAME  "
											},
											{
												"name": "CALL_COMMAND",
												"value": "@concat('CALL CONTROL.PR_LOG_RUN_PLAN (',item().EXTRACT_RUN_PLAN_ID,',''', variables('vConst_BlobCopy_Status'),''',''',variables('vConst_Complete'),''')' )"
											}
										],
										"typeProperties": {
											"source": {
												"type": "SnowflakeV2Source",
												"query": {
													"value": "@concat('CALL CONTROL.PR_LOG_EXTRACT_RUN_PLAN (',item().EXTRACT_RUN_PLAN_ID,',''', variables('vConst_Rows_Read'),''',''',variables('vRows_Read'),''',''Successful'');')\n",
													"type": "Expression"
												},
												"exportSettings": {
													"type": "SnowflakeExportCopyCommand"
												}
											},
											"dataset": {
												"referenceName": "DS_Snowflake_Wh",
												"type": "DatasetReference"
											}
										}
									},
									{
										"name": "Set vCopy_Error",
										"type": "SetVariable",
										"dependsOn": [
											{
												"activity": "Copy to BLOB",
												"dependencyConditions": [
													"Failed"
												]
											}
										],
										"policy": {
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"variableName": "vCopy_Error",
											"value": {
												"value": "@string(activity('Copy to BLOB').output.errors)",
												"type": "Expression"
											}
										}
									}
								]
							}
						},
						{
							"name": "Provision SI artifacts and load data",
							"type": "Lookup",
							"dependsOn": [
								{
									"activity": "Check if blobcopy is COMPLETE",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "7.00:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [
								{
									"name": "OBJECT_NAME",
									"value": "@item().OBJECT_NAME "
								},
								{
									"name": "CALL _COMMAND",
									"value": "@concat('CALL CONTROL.PR_CREATE_SI_ARTIFACTS (',item().EXTRACT_META_ID,',',item().EXTRACT_RUN_PLAN_ID,')')"
								}
							],
							"typeProperties": {
								"source": {
									"type": "SnowflakeV2Source",
									"query": {
										"value": "@concat('CALL CONTROL.PR_CREATE_EXTRACT_ARTIFACTS (',item().EXTRACT_META_ID,',',item().EXTRACT_RUN_PLAN_ID,')')",
										"type": "Expression"
									},
									"exportSettings": {
										"type": "SnowflakeExportCopyCommand"
									}
								},
								"dataset": {
									"referenceName": "DS_Snowflake_Wh",
									"type": "DatasetReference"
								}
							}
						},
						{
							"name": "Complete ETL run",
							"type": "Lookup",
							"dependsOn": [
								{
									"activity": "Provision SI artifacts and load data",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "7.00:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [
								{
									"name": "OBJECT_NAME",
									"value": "@item().OBJECT_NAME  "
								},
								{
									"name": "CALL_COMMAND",
									"value": "@concat('CALL CONTROL.PR_LOG_RUN_PLAN (',item().EXTRACT_RUN_PLAN_ID,',''', variables('vConst_BlobCopy_Status'),''',''',variables('vConst_Complete'),''')' )"
								}
							],
							"typeProperties": {
								"source": {
									"type": "SnowflakeV2Source",
									"query": {
										"value": "@concat('CALL CONTROL.PR_LOG_EXTRACT_RUN_PLAN (',item().EXTRACT_RUN_PLAN_ID,',''', variables('vConst_Run_Status'),''',''',variables('vConst_Complete'),''',''Successful'');')",
										"type": "Expression"
									},
									"exportSettings": {
										"type": "SnowflakeExportCopyCommand"
									}
								},
								"dataset": {
									"referenceName": "DS_Snowflake_Wh",
									"type": "DatasetReference"
								}
							}
						},
						{
							"name": "Check if source archive is COMPLETE",
							"type": "IfCondition",
							"dependsOn": [
								{
									"activity": "Check if blobcopy is COMPLETE",
									"dependencyConditions": [
										"Skipped"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"expression": {
									"value": "@equals(item().SOURCE_ARCHIVE_STATUS,variables('vConst_Complete'))",
									"type": "Expression"
								},
								"ifFalseActivities": [
									{
										"name": "Archive source file_copy",
										"type": "Copy",
										"dependsOn": [],
										"policy": {
											"timeout": "7.00:00:00",
											"retry": 0,
											"retryIntervalInSeconds": 30,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [
											{
												"name": "file_name",
												"value": "@concat(item().SOURCE_NAME,'/',item().LVL2_FOLDER_NAME,'/',item().OBJECT_NAME)"
											}
										],
										"typeProperties": {
											"source": {
												"type": "BinarySource",
												"storeSettings": {
													"type": "AzureBlobStorageReadSettings",
													"recursive": true
												},
												"formatSettings": {
													"type": "BinaryReadSettings"
												}
											},
											"sink": {
												"type": "BinarySink",
												"storeSettings": {
													"type": "AzureBlobStorageWriteSettings"
												}
											},
											"enableStaging": false
										},
										"inputs": [
											{
												"referenceName": "DS_STORAGE_V2_STAGE_BIN",
												"type": "DatasetReference",
												"parameters": {
													"Folder": "sdsds",
													"Container": {
														"value": "@pipeline().globalParameters.StagingContainer",
														"type": "Expression"
													}
												}
											}
										],
										"outputs": [
											{
												"referenceName": "DS_STORAGE_V2_STAGE_BIN",
												"type": "DatasetReference",
												"parameters": {
													"Folder": "dsdsdsd",
													"Container": {
														"value": "@pipeline().globalParameters.StagingContainer",
														"type": "Expression"
													}
												}
											}
										]
									},
									{
										"name": "Complete Source Archive",
										"type": "Lookup",
										"dependsOn": [
											{
												"activity": "Archive source file_copy",
												"dependencyConditions": [
													"Succeeded"
												]
											}
										],
										"policy": {
											"timeout": "7.00:00:00",
											"retry": 0,
											"retryIntervalInSeconds": 30,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [
											{
												"name": "OBJECT_NAME",
												"value": "@item().OBJECT_NAME  "
											},
											{
												"name": "CALL_COMMAND",
												"value": "@concat('CALL CONTROL.PR_LOG_RUN_PLAN (',item().EXTRACT_RUN_PLAN_ID,',''', variables('vConst_BlobCopy_Status'),''',''',variables('vConst_Complete'),''')' )"
											}
										],
										"typeProperties": {
											"source": {
												"type": "SnowflakeV2Source",
												"query": {
													"value": "@concat('CALL CONTROL.PR_LOG_EXTRACT_RUN_PLAN (',item().EXTRACT_RUN_PLAN_ID,',''', variables('vConst_SourceArchive_Status'),''',''',variables('vConst_Complete'),''',''Successful'');')",
													"type": "Expression"
												},
												"exportSettings": {
													"type": "SnowflakeExportCopyCommand"
												}
											},
											"dataset": {
												"referenceName": "DS_Snowflake_Wh",
												"type": "DatasetReference"
											}
										}
									},
									{
										"name": "Fail Source archive",
										"type": "Lookup",
										"dependsOn": [
											{
												"activity": "Archive source file_copy",
												"dependencyConditions": [
													"Failed"
												]
											}
										],
										"policy": {
											"timeout": "7.00:00:00",
											"retry": 0,
											"retryIntervalInSeconds": 30,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [
											{
												"name": "OBJECT_NAME",
												"value": "@item().OBJECT_NAME  "
											},
											{
												"name": "CALL_COMMAND",
												"value": "@concat('CALL CONTROL.PR_LOG_RUN_PLAN (',item().EXTRACT_RUN_PLAN_ID,',''', variables('vConst_BlobCopy_Status'),''',''',variables('vConst_Complete'),''')' )"
											}
										],
										"typeProperties": {
											"source": {
												"type": "SnowflakeV2Source",
												"query": {
													"value": "@concat('CALL CONTROL.PR_LOG_EXTRACT_RUN_PLAN (',item().EXTRACT_RUN_PLAN_ID,',''', variables('vConst_SourceArchive_Status'),''',''',variables('vConst_Fail'),''',''','''FAILED :',pipeline().Pipeline,' - Source archaive failed''',''')' )",
													"type": "Expression"
												},
												"exportSettings": {
													"type": "SnowflakeExportCopyCommand"
												}
											},
											"dataset": {
												"referenceName": "DS_Snowflake_Wh",
												"type": "DatasetReference"
											}
										}
									}
								]
							}
						},
						{
							"name": "Check delete file",
							"type": "IfCondition",
							"dependsOn": [
								{
									"activity": "Check if source archive is COMPLETE",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"expression": {
									"value": "@bool(item().REMOVE_SOURCE_FILE_FLAG)",
									"type": "Expression"
								},
								"ifTrueActivities": [
									{
										"name": "Delete Source File",
										"type": "Delete",
										"dependsOn": [],
										"policy": {
											"timeout": "7.00:00:00",
											"retry": 0,
											"retryIntervalInSeconds": 30,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"dataset": {
												"referenceName": "DS_STORAGE_V2_STAGE_BIN",
												"type": "DatasetReference",
												"parameters": {
													"Folder": "dsdsdsd",
													"Container": {
														"value": "@pipeline().globalParameters.StagingContainer",
														"type": "Expression"
													}
												}
											},
											"enableLogging": false,
											"storeSettings": {
												"type": "AzureBlobStorageReadSettings",
												"recursive": true,
												"wildcardFileName": {
													"value": "@{item().OBJECT_NAME}",
													"type": "Expression"
												}
											}
										}
									}
								]
							}
						}
					]
				}
			},
			{
				"name": "Get run plan",
				"type": "Lookup",
				"dependsOn": [
					{
						"activity": "Loop through folders",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "7.00:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [
					{
						"name": "CALL_COMMAND",
						"value": "@concat('SELECT  * FROM  CONTROL.ETL_RUN_PLAN_VW WHERE SOURCE_NAME =''',variables('vSource_Name'),'''')"
					}
				],
				"typeProperties": {
					"source": {
						"type": "SnowflakeV2Source",
						"query": {
							"value": "@concat('SELECT  A.* FROM\n CONTROL.EXTRACT_RUN_PLAN_VW A INNER JOIN CONTROL.EXTRACT_META B ON A.EXTRACT_META_ID = B.EXTRACT_META_ID WHERE B.ACTIVE_FLAG= TRUE AND UPPER(A.SOURCE_NAME) = UPPER(''',pipeline().parameters.p_Source_Name,''')',' ORDER BY FILE_NAME')",
							"type": "Expression"
						},
						"exportSettings": {
							"type": "SnowflakeExportCopyCommand"
						}
					},
					"dataset": {
						"referenceName": "DS_Snowflake_Wh",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "Loop through folders",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "Get Source_Path from META",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('Get Source_Path from META').output.value",
						"type": "Expression"
					},
					"activities": [
						{
							"name": "Get File Metadata",
							"type": "GetMetadata",
							"dependsOn": [],
							"policy": {
								"timeout": "7.00:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"dataset": {
									"referenceName": "DS_Storage_Parquetfiles",
									"type": "DatasetReference",
									"parameters": {
										"Folder": {
											"value": "@concat('/',item().SOURCE_PATH)",
											"type": "Expression"
										},
										"File": "*",
										"Container": {
											"value": "@pipeline().globalParameters.StagingContainer",
											"type": "Expression"
										}
									}
								},
								"fieldList": [
									"childItems"
								],
								"storeSettings": {
									"type": "AzureBlobStorageReadSettings",
									"recursive": true
								},
								"formatSettings": {
									"type": "ParquetReadSettings"
								}
							}
						},
						{
							"name": "Generate Run Plan",
							"type": "Lookup",
							"dependsOn": [
								{
									"activity": "Get File Metadata",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
